{
  "name": "@botom/quill-resize-module",
  "version": "2.1.0",
  "description": "Modern, secure Quill.js module to resize images, GIFs, videos, and iframes — touch & pinch-to-resize, keyboard accessible, persistent sizing through Quill Deltas, upload hooks, and zero known high-severity vulnerabilities.",
  "main": "./dist/quill-resize-module.min.js",
  "module": "./dist/quill-resize-module.esm.mjs",
  "types": "./types/main.d.ts",
  "exports": {
    ".": {
      "types": "./types/main.d.ts",
      "import": "./dist/quill-resize-module.esm.mjs",
      "require": "./dist/quill-resize-module.min.js",
      "default": "./dist/quill-resize-module.min.js"
    },
    "./package.json": "./package.json"
  },
  "author": {
    "name": "Edwar Diaz",
    "email": "edwardiaz.dev@gmail.com",
    "url": "https://github.com/BOTOOM"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BOTOOM/quill-resize-module.git"
  },
  "bugs": {
    "url": "https://github.com/BOTOOM/quill-resize-module/issues"
  },
  "homepage": "https://github.com/BOTOOM/quill-resize-module#readme",
  "license": "MIT",
  "keywords": [
    "quill",
    "quill2",
    "quill-editor",
    "quilljs",
    "image-resize",
    "video-resize",
    "iframe-resize",
    "gif-resize",
    "media-resize",
    "quill-module",
    "quill-plugin",
    "rich-text-editor",
    "wysiwyg",
    "wysiwyg-editor",
    "editor-plugin",
    "secure",
    "modern",
    "typescript",
    "zero-vulnerabilities",
    "semantic-release",
    "auto-resize",
    "drag-resize",
    "responsive",
    "accessibility",
    "a11y",
    "keyboard-accessible",
    "lightweight",
    "performance",
    "touch",
    "mobile",
    "pointer-events",
    "pinch-to-resize",
    "pinch-zoom",
    "touch-resize",
    "image-upload",
    "upload-hook",
    "image-compression",
    "persistence",
    "esm",
    "framework-agnostic",
    "react",
    "vue",
    "angular"
  ],
  "devDependencies": {
    "@commitlint/cli": "^18.2.0",
    "@commitlint/config-conventional": "^18.1.0",
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.2.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^11.1.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/npm": "^13.1.4",
    "@size-limit/file": "^11.2.0",
    "@types/ms": "^0.7.30",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^9.39.2",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "less": "^4.5.1",
    "quill": "^2.0.3",
    "rollup": "^3.29.0",
    "rollup-plugin-postcss": "^4.0.2",
    "semantic-release": "^25.0.3",
    "standard-version": "^9.5.0",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "quill": "^2.0.0"
  },
  "overrides": {
    "yaml@1.10.2": "1.10.3"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "scripts": {
    "build": "rollup -c && npm run build:types",
    "build:types": "tsc -p tsconfig.json",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "size": "size-limit",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "release:major": "standard-version --release-as major"
  },
  "files": [
    "dist/*.js",
    "dist/*.mjs",
    "dist/*.map",
    "types/*.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "size-limit": [
    {
      "path": "./dist/quill-resize-module.min.js",
      "limit": "15 kB"
    }
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
